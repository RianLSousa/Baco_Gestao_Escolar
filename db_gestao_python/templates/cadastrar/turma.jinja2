<!-- cadastrar/turma.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}GESTÃO ESCOLAR{% endblock %}
{% block title %}Cadastrar Turma{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Cadastro de Turma
</h2>

<form class="text-center" action="{{ api }}" method="post">
    {{ macros.render_input("Nome da Turma:", "text", "nome_turma", "") }}
    {{ macros.render_input("Ano Letivo:", "number", "ano_letivo", "2026") }}
    {{ macros.render_input("Sala de Aula:", "text", "sala_aula", "") }}

    <!-- Disciplinas vinculadas à turma -->
    {{ macros.render_checkboxes("Disciplinas da Turma:", "disciplinas", todas_disciplinas, []) }}

    <button type="submit" class="btn btn-primary mt-3">Cadastrar Turma</button>
</form>

{% endblock %}
