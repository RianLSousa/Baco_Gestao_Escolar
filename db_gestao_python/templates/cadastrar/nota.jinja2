<!-- cadastrar/nota.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}GESTÃO ESCOLAR{% endblock %}
{% block title %}Lançar Nota{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Lançamento de Nota do Aluno
</h2>

<form class="text-center" action="{{ api }}" method="post">
    <!-- Seleção de Aluno, Turma e Disciplina -->
    {{ macros.render_select("Aluno:", "id_aluno", alunos, "") }}
    {{ macros.render_select("Turma:", "id_turma", turmas, "") }}
    {{ macros.render_select("Disciplina:", "id_disciplina", disciplinas, "") }}

    <!-- Unidade e Nota -->
    {% set opcoes_unidade = [
        ("1", "Unidade 1"),
        ("2", "Unidade 2"),
        ("3", "Unidade 3"),
        ("4", "Unidade 4")
    ] %}
    {{ macros.render_select("Unidade:", "unidade", opcoes_unidade, "1") }}
    {{ macros.render_input("Nota (0.00 a 10.00):", "number\" step=\"0.01\" min=\"0\" max=\"10", "nota", "") }}

    <button type="submit" class="btn btn-primary mt-3">Lançar Nota</button>
</form>

{% endblock %}
