{% macro render_button(text, url) %}
<a href="{{ url_for(url) }}" class="button">{{ text }}</a>
{% endmacro %}

{% macro render_nav_dropdown(menu_text, menu_items) %}
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        {{ menu_text }}
    </a>
    <ul class="dropdown-menu">
        {% for url, text in menu_items.items() %}
        <li><a class="dropdown-item" href="{{ url }}">{{ text }}</a></li>
        {% endfor %}
    </ul>
</li>
{% endmacro %}

{% macro render_nav_button(text, url) %}
<li class="nav-item">
    <a class="nav-link" href="{{ url_for(url) }}">{{ text }}</a>
</li>
{% endmacro %}

{% macro render_input(texto, tipo, id, valor) %}
<div class="row mb-3">
    <label for="{{ id }}" class="col-sm-2 col-form-label text-right">{{ texto }}</label>
    <div class="col">
        <input type="{{ tipo }}" class="form-control" id="{{ id }}" name="{{ id }}" value="{{ valor }}">
    </div>
</div>
{% endmacro %}

{% macro render_select(texto, id, opcoes, value_selected) %}
<div class="row mb-3">
    <label for="{{ id }}" class="col-sm-2 col-form-label">{{ texto }}</label>
    <div class="col-sm-10">
        <select class="form-select" aria-label="Default select example" id="{{ id }}" name="{{ id }}">
            {% for valor, texto_opcao in opcoes %}
            {% set selected = "selected" if value_selected|string == valor|string else "" %}
            <option value="{{ valor }}" {{ selected }}>{{ texto_opcao }}</option>
            {% endfor %}
        </select>
    </div>
</div>
{% endmacro %}

{% macro render_checkboxes(texto, id_name, opcoes, valores_selecionados) %}
<div class="row mb-3 text-start">
    <label class="col-sm-2 col-form-label">{{ texto }}</label>
    <div class="col-sm-10">
        <div class="card p-3 bg-light">
            <div class="row">
                {% for valor, rotulo in opcoes %}
                {% set checked = "checked" if valor in valores_selecionados or (valor|string) in valores_selecionados else "" %}
                <div class="col-md-6 mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="{{ id_name }}" value="{{ valor }}" id="{{ id_name }}_{{ valor }}" {{ checked }}>
                        <label class="form-check-label" for="{{ id_name }}_{{ valor }}">
                            {{ rotulo }}
                        </label>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endmacro %}

{% macro render_table(cabecalho, dados) %}
<div class="container table-responsive">
    <table class="table table-hover align-middle border ">
        <thead>
            <tr>
                {% for texto in cabecalho %}
                <th scope="col">{{ texto }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for linha in dados %}
            <tr>
                {% for dado in linha %}
                <td scope="row">{{ dado }}</td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}