<!-- login.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}GESTÃO ESCOLAR{% endblock %}
{% block title %}Login{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Entrar no Sistema
</h2>

{% if erro %}
<div class="alert alert-danger text-center" role="alert">
    {{ erro }}
</div>
{% endif %}

<form class="text-center" action="{{ url_for('api_login') }}" method="post">
    {{ macros.render_input("Usuário:", "text", "usuario", "") }}
    {{ macros.render_input("Senha:", "password", "senha", "") }}

    <button type="submit" class="btn btn-primary mt-3">Entrar</button>
</form>

{% endblock %}