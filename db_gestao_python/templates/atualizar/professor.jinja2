<!-- atualizar/professor.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}GESTÃO ESCOLAR{% endblock %}
{% block title %}Atualizar Professor{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Atualizar Professor
</h2>

<form class="text-center" action="{{ api }}" method="post">
    <!-- Campo oculto para o ID -->
    {{ macros.render_input("", "hidden", "id_professor", id_professor) }}

    {{ macros.render_input("Nome:", "text", "nome", nome) }}
    {{ macros.render_input("Data de Nascimento:", "date", "data_nascimento", data_nascimento) }}
    {{ macros.render_input("Carga Horária Semanal (h):", "number", "carga_horaria_trabalho", carga_horaria_trabalho) }}

    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>

{% endblock %}
