<!-- atualizar/aluno.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}GESTÃO ESCOLAR{% endblock %}
{% block title %}Atualizar Aluno{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Atualizar Aluno
</h2>

<form class="text-center" action="{{ api }}" method="post">
    <!-- Campo oculto para o ID -->
    {{ macros.render_input("", "hidden", "id_aluno", id_aluno) }}

    {{ macros.render_input("Nome:", "text", "nome", nome) }}
    {{ macros.render_input("Data de Nascimento:", "date", "data_nascimento", data_nascimento) }}
    {{ macros.render_input("Endereço:", "text", "endereco", endereco) }}
    {{ macros.render_input("Telefone:", "text", "telefone", telefone) }}

    <!-- Seleção da Turma -->
    {{ macros.render_select("Turma:", "id_turma", turmas, id_turma) }}

    <hr class="my-4">
    <h5 class="text-start mb-3 text-secondary">Condições Médicas / Alergias / Deficiências</h5>

    <!-- Modelo de uma linha em branco, usado pelo JS ao clicar em "Adicionar Condição" -->
    <template id="template-condicao">
        <div class="row mb-2 align-items-center condicao-row">
            <div class="col-5">
                <select class="form-select" name="tipo_condicao">
                    <option value="">Selecione o tipo</option>
                    {% for id_tipo, nome_tipo in tipos_condicao %}
                    <option value="{{ id_tipo }}">{{ nome_tipo }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-5">
                <input type="text" class="form-control" name="descricao_condicao" placeholder="Descrição (ex.: Alergia a amendoim)">
            </div>
            <div class="col-2">
                <button type="button" class="btn btn-outline-danger btn-sm remove-condicao">Remover</button>
            </div>
        </div>
    </template>

    <!-- Linhas já existentes do aluno, pré-preenchidas pelo backend -->
    <div id="condicoes-container" class="text-start">
        {% for id_tipo_atual, descricao_atual in condicoes %}
        <div class="row mb-2 align-items-center condicao-row">
            <div class="col-5">
                <select class="form-select" name="tipo_condicao">
                    <option value="">Selecione o tipo</option>
                    {% for id_tipo, nome_tipo in tipos_condicao %}
                    {% set selecionado = "selected" if id_tipo|string == id_tipo_atual|string else "" %}
                    <option value="{{ id_tipo }}" {{ selecionado }}>{{ nome_tipo }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-5">
                <input type="text" class="form-control" name="descricao_condicao" value="{{ descricao_atual }}">
            </div>
            <div class="col-2">
                <button type="button" class="btn btn-outline-danger btn-sm remove-condicao">Remover</button>
            </div>
        </div>
        {% endfor %}
    </div>

    <button type="button" id="btn-add-condicao" class="btn btn-outline-secondary btn-sm mt-2 mb-3">
        + Adicionar Condição
    </button>

    <br>
    <button type="submit" class="btn btn-primary mt-3">Atualizar Aluno</button>
</form>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const template = document.getElementById('template-condicao');
    const container = document.getElementById('condicoes-container');

    function adicionarLinhaCondicao() {
        const clone = template.content.cloneNode(true);
        container.appendChild(clone);
    }

    container.addEventListener('click', function (evento) {
        if (evento.target.classList.contains('remove-condicao')) {
            evento.target.closest('.condicao-row').remove();
        }
    });

    document.getElementById('btn-add-condicao').addEventListener('click', adicionarLinhaCondicao);
});
</script>

{% endblock %}